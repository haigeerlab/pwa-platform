{
  "identity": {
    "appId": "storefront",
    "manifestId": "/app/",
    "origin": "https://shop.example.com",
    "scope": "/app/",
    "serviceWorkerUrl": "/app/sw.js",
    "manifestUrl": "/app/manifest.webmanifest",
    "mountPath": "/app",
    "environment": "production",
    "cacheNamespaceSeed": "r3"
  },
  "install": {
    "startUrl": "/app/",
    "display": "standalone",
    "name": "Storefront",
    "shortName": "Shop",
    "themeColor": "#0f172a",
    "backgroundColor": "#ffffff",
    "icons": [
      { "src": "/app/icons/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
      { "src": "/app/icons/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
      { "src": "/app/icons/maskable.png", "sizes": "192x192 512x512", "type": "image/png", "purpose": "maskable" }
    ]
  },
  "policy": {
    "schemaVersion": 1,
    "install": { "enabled": true },
    "offlineFallback": { "enabled": true, "path": "/offline.html" },
    "updateMode": "prompt",
    "resources": [
      { "pathPrefix": "/", "resourceClass": "navigation-public-static", "cache": "network-first" },
      { "pathPrefix": "/assets", "resourceClass": "asset", "cache": "cache-first" },
      { "pathPrefix": "/fonts", "resourceClass": "asset", "cache": "cache-first" },
      { "pathPrefix": "/api/catalog", "resourceClass": "public-data", "cache": "stale-while-revalidate" },
      { "pathPrefix": "/api/account", "resourceClass": "session-data", "cache": "none" },
      { "pathPrefix": "/api/orders", "resourceClass": "mutation", "cache": "none" },
      { "pathPrefix": "/live", "resourceClass": "stream", "cache": "none" }
    ],
    "extensions": { "acme.analytics": { "sampled": true } }
  },
  "topology": { "kind": "standalone-origin" },
  "hostBuildOutput": {
    "publicPath": "/app/",
    "serviceWorkerFile": "sw.js",
    "manifestFile": "manifest.webmanifest",
    "files": [
      { "path": "index.html", "fingerprinted": false, "contentHash": "5d41402abc4b2a76" },
      { "path": "offline.html", "fingerprinted": false, "contentHash": "7d793037a0760186" },
      { "path": "assets/app.3f9a2c7d.js", "fingerprinted": true, "contentHash": "3f9a2c7d1e8b4c60" },
      { "path": "assets/app.3f9a2c7d.js.map", "fingerprinted": true, "contentHash": "3f9a2c7d1e8b4c61" },
      { "path": "assets/logo.svg", "fingerprinted": false, "contentHash": "a1b2c3d4e5f60718" },
      { "path": "api/catalog/featured.json", "fingerprinted": false, "contentHash": "0cc175b9c0f1b6a8" },
      { "path": "sw.js", "fingerprinted": false, "contentHash": "92eb5ffee6ae2fec" },
      { "path": "manifest.webmanifest", "fingerprinted": false, "contentHash": "e4d909c290d0fb1c" }
    ]
  }
}
