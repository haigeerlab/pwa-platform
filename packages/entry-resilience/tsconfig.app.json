{
  // The fixture app's browser sources. `types` is empty on purpose: nothing Node-specific may type-check here.
  // `src/virtual.d.ts` is included so the fixture app's import of `virtual:pwa-entry-config` (via
  // src/client/index.ts) resolves to a declared type.
  //
  // EM4 (tasks/pwa-entry-resilience/plan.md, 2026-09-23) removed the separate scenario app: one fixture app now
  // covers both the feasibility checks and the T7 scenarios, since ADR-0033 removed the build-time seed that used
  // to make the scenario app's build meaningfully different from the fixture app's.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "browser-tests/fixture-app/src/**/*.ts",
    "src/virtual.d.ts"
  ]
}
