{
  "name": "@pwa-platform/client-runtime",
  "version": "0.2.4",
  "description": "Browser registration and update lifecycle for PWA Platform.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.dom.build.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:engines": "playwright install webkit firefox && playwright test --config playwright.engines.config.ts",
    "test:browser:real": "playwright test --config playwright.real.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.dom.json && tsc --noEmit --project tsconfig.browser.json"
  },
  "dependencies": {
    "@pwa-platform/contracts": "workspace:*",
    "@pwa-platform/sw-runtime": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@pwa-platform/browser-test-harness": "workspace:*",
    "@pwa-platform/core": "workspace:*",
    "@pwa-platform/engine-workbox": "workspace:*",
    "@types/node": "24.13.4",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  }
}
