{
  // The Node side: the build configuration each example carries and the identity both share. The browser-side
  // sources live in tsconfig.app.json, which has the DOM lib this one deliberately lacks.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // onboarding-smoke/template/vite.config.ts imports "./pwa.config.ts" with the .ts extension, per
    // website/start/react.md step 2's literal example and its own TS5097 guidance.
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/shared/**/*.ts",
    "apps/*/vite.config.ts",
    "browser-tests/**/*.ts",
    "browser-tests-network/**/*.ts",
    "ui-browser-tests/**/*.ts",
    "ssr-tests/**/*.ts",
    "onboarding-smoke/*.ts",
    "onboarding-smoke/template/*.ts",
    "playwright.config.ts",
    "playwright.network.config.ts",
    "playwright.ui.config.ts",
    "playwright.real.config.ts"
  ]
}
