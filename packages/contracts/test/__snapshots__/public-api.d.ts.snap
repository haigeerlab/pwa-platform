type Expand<T> = {
    readonly [Key in keyof T]: T[Key];
};
/** Compiled v1 plan. Closed shape: exactly these 15 required fields plus the optional `networkTimeoutSeconds`, no extensions. */
export type PwaPlanV1 = Expand<PwaPlanFields & {
