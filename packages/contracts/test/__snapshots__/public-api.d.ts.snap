export type PwaPlan = PwaPlanV1 | PwaPlanV2 | PwaPlanV3;
export {};

// ---- policy.d.ts ----
import type { PwaExtensions } from "./json.js";
export declare const RESOURCE_CLASSES: readonly ["asset", "navigation-public-static", "navigation-public-dynamic", "public-data", "session-data", "mutation", "stream", "unclassified"];
export type PwaResourceClass = (typeof RESOURCE_CLASSES)[number];
export declare const CACHE_STRATEGIES: readonly ["none", "cache-first", "network-first", "stale-while-revalidate"];
export type PwaCacheStrategy = (typeof CACHE_STRATEGIES)[number];
export declare const UPDATE_MODES: readonly ["prompt"];
export type PwaUpdateMode = (typeof UPDATE_MODES)[number];
/**
 * Path prefix relative to `PwaIdentity.mountPath`. Matched on whole path segments,
 * ignoring query and fragment; no glob, regular expression or callback forms exist.
 */
