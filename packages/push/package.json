{
  "name": "@pwa-platform/push",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json && tsc --noEmit --project tsconfig.browser.json"
  },
  "dependencies": {
    "@pwa-platform/sw-runtime": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@pwa-platform/browser-test-harness": "workspace:*",
    "@types/node": "24.13.4"
  }
}
